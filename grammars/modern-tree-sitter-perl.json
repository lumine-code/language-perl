{
  "name": "PERL",
  "scopeName": "source.perl",
  "type": "modern-tree-sitter",
  "parser": "tree-sitter-perl",
  "injectionRegex": "^perl$",
  // Matches the TextMate grammar's shebang rule, which would otherwise win by
  // 0.5 against the 0.1 that prefers Tree-sitter. `\b` after `perl` is what
  // keeps a `perl6` shebang out; that belongs to the Perl 6 grammar.
  "firstLineRegex": ["^#!.*\\bperl\\b", "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=perl"],
  "fileTypes": ["pl", "PL", "pm", "pod", "psgi", "t"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:tree-sitter-perl/tree-sitter-perl#0390ac6f4e26f5805c9d7d9b950685436faa6359",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "tree-sitter-perl/tree-sitter-perl.wasm",
    "highlightsQuery": "tree-sitter-perl/highlights.scm",
    "foldsQuery": "tree-sitter-perl/folds.scm"
  }
}
