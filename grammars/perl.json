{
  "name": "PERL",
  "scopeName": "source.perl",
  "type": "tree-sitter",
  "parser": "tree-sitter-perl",
  "injectionNames": ["perl", "cperl"],
  // `\b` after `perl` deliberately keeps unsupported Raku/perl6 shebangs out.
  // Stop at the first Vim and set tokens instead of backtracking over them.
  // \x0a keeps existing shebang prefix line counts unchanged.
  "firstLineRegex": [
    "^#!.*\\bperl\\b",
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=perl"
  ],
  "fileTypes": ["pl", "PL", "pm", "pod", "psgi", "t"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:tree-sitter-perl/tree-sitter-perl#775e75a51c1230fccbde7d607cd6d424b0ce1016",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "perl.wasm",
    "tagsQuery": "perl-tags.scm",
    "highlightsQuery": "perl-highlights.scm",
    "foldsQuery": "perl-folds.scm"
  }
}
