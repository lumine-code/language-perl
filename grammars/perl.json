{
  "name": "PERL",
  "scopeName": "source.perl",
  "type": "tree-sitter",
  "parser": "tree-sitter-perl",
  "injectionNames": ["perl"],
  // `\b` after `perl` deliberately keeps unsupported Raku/perl6 shebangs out.
  "firstLineRegex": ["^#!.*\\bperl\\b", "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=perl"],
  "fileTypes": ["pl", "PL", "pm", "pod", "psgi", "t"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:tree-sitter-perl/tree-sitter-perl#0390ac6f4e26f5805c9d7d9b950685436faa6359",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "perl.wasm",
    "highlightsQuery": "perl-highlights.scm",
    "foldsQuery": "perl-folds.scm"
  }
}
